FROM node:22-alpine AS builder

WORKDIR /app

COPY .npmrc electron/package*.json ./electron/
COPY scripts/frontend ./scripts/frontend

WORKDIR /app/electron
# npm 版本钉死（2026-10-09）：node:22-alpine 自带的 npm 10.9.x 在解析本依赖树时
# arborist 崩溃（Cannot read properties of null (reading 'edgesOut')，10.9.2/10.9.9
# 均复现；11.21.0 通过）。依赖范围浮动 + npm 浮动 = 构建随上游随机成败，这里把
# npm 这一半钉死。npm 11 默认不跑未审批的 install 脚本（@swc/core、esbuild、
# core-js 的 postinstall 被跳过）——三者都靠平台可选依赖供二进制/无必要，vite
# 构建不依赖其 postinstall（2026-10-09 重建实证：8375 modules，31s 构建通过）。
RUN npm install -g npm@11.21.0
# Strip the `overrides` block from package.json — newer npm flags
# `monaco-editor` override against direct `^0.55.1` dep as EOVERRIDE.
# Override is only meaningful for transitive dedupe and not needed for the web build.
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.overrides;delete p.scripts.postinstall;fs.writeFileSync('package.json',JSON.stringify(p,null,2));"
RUN npm install --no-audit --no-fund

COPY electron ./
# Re-strip after the full electron/ copy overwrites package.json
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.overrides;fs.writeFileSync('package.json',JSON.stringify(p,null,2));"

# 实盘交易 UI（2026-11-05）：**默认不部署**。只有部署方在 .env 里显式
# ENABLE_REAL_TRADING=true（即用户自己打开了实盘），deploy/update.sh 才会把
# VITE_ENABLE_REAL_TRADING=true 传进来重建；否则每次更新都用默认 false，
# 底部栏不会出现「实盘交易」入口，账户概览也不会显示真实券商账户。
# 它与后端 ENABLE_REAL_TRADING 是同一件事的两端；前端开关是 Vite 构建期内联，
# 镜像建好后无法靠重启/强刷补出来，必须重建（一键更新会自动重建）。
ARG VITE_ENABLE_REAL_TRADING=false
ENV VITE_ENABLE_REAL_TRADING=${VITE_ENABLE_REAL_TRADING}

# 文档挖掘 UI（因子挖掘「上传文档」链）出厂默认开启（2026-10-24 用户拍板）：
# Docker 服务器版**第一次安装、第一次启动**就要能打开，不允许"装完没有、再重建/重启一轮"。
# 前端开关是 Vite **构建期内联**——镜像构建时没开，容器重启、浏览器强刷都补不出来。
# 显式关闭（重建镜像）：
#   docker build --build-arg VITE_ENABLE_DOC_MINING=false \
#     -f docker/Dockerfile.web -t quantmind-web:latest .
# 后端还有独立闸门 ENABLE_DOC_MINING（docker-compose.yml 缺省 true）；两端同时关才彻底不可用。
# 上传的原件会送到 MinerU 云端解析（数据出网），界面上传区有固定披露。
ARG VITE_ENABLE_DOC_MINING=true
ENV VITE_ENABLE_DOC_MINING=${VITE_ENABLE_DOC_MINING}
RUN node ../scripts/frontend/copy-monaco-assets.js && npx vite build

FROM nginx:1.25-alpine

# Remove the default server block that conflicts with our nginx.conf
RUN rm -f /etc/nginx/conf.d/default.conf

COPY docker/web/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/electron/dist-react /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
