# minibt 专用 AI-IDE 运行时镜像(py3.12 + 裁剪版 minibt + 指标库全家桶)
# 构建: bash docker/build_minibt_runner.sh
# 用途: ai-ide executor 检测到 `import minibt` 的策略代码时,以此镜像运行兄弟容器
ARG BASE=python:3.12-slim-bookworm

FROM ${BASE} AS builder
ARG PIP_INDEX_URL=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip \
    && pip install "numpy==2.2.6" "cython>=3.0" setuptools

# 顺序关键: numpy_ext 必须 --no-deps(其依赖解析会把 numpy 拖到 1.x),收尾 re-pin 并断言
RUN pip install --no-deps "numpy-ext==0.9.9" "joblib" \
    && pip install "cloudpickle" "pandas==2.3.3" "pandas-ta==0.4.71b0" "numba==0.61.2" \
                   "duckdb==1.5.5" "networkx==3.6.1" "TA-Lib==0.7.1" \
                   "finta==1.3" "quantstats==0.0.81" "statsmodels==0.15.0" \
                   "scipy==1.18.1" "arch==8.0.0" "pykalman==0.11.2" \
                   "rich" "colorlog" \
                   "cachetools" "retrying" "addict" "psutil" \
                   "iteration-utilities" "typing-extensions" \
    && pip install "numpy==2.2.6" "pandas==2.3.3" \
    && python -c "import numpy; assert numpy.__version__=='2.2.6', numpy.__version__"

COPY minibt/ /app/minibt/
WORKDIR /app
RUN python /app/minibt/_build_exts.py build_ext --inplace \
    && python -c "import sys; sys.path.insert(0,'/app'); import minibt; import minibt.cython_functions.backtest_engine; print('minibt ext build ok')"

FROM ${BASE}
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    QM_QUANTDB_DATA_DIR=/data/quantdb \
    PIP_DISABLE_PIP_VERSION_CHECK=1
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /app/minibt /app/minibt
CMD ["python", "-c", "import minibt; print('minibt runner ready', minibt.__version__)"]
