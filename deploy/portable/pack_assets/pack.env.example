# QuantMind 便携版可选配置
# 复制本文件为 pack.env 并按需修改（Windows 的 start.bat 与 Linux/WSL 的
# start.sh 都会读取本文件；未配置时用各自默认值）

# 服务端口（默认与 docker 版一致，端口被占用时改这里）
# QM_PG_PORT=5432
# QM_REDIS_PORT=6379
# QM_API_PORT=8000
# QM_ENGINE_PORT=8001
# QM_TRADE_PORT=8002
# QM_STREAM_PORT=8003

# AI/LLM 密钥也可以直接写在本文件（或 .env）中，例如：
# DEEPSEEK_API_KEY=sk-xxxx
# DASHSCOPE_API_KEY=sk-xxxx

# TDX 通达信桥（需要实盘推送时配置，默认关闭）
# ENABLE_TDX_PUSH=true
# TDX_BRIDGE_URL=http://192.168.31.31:8550
# TDX_BRIDGE_TOKEN=xxxx

# 首次启动不自动打开浏览器（服务器/无桌面环境）
# QM_OPEN_BROWSER=0

# 模型训练执行方式（默认 auto：有 Docker daemon 用容器训练，否则本机 python 直跑；
# 无需修改，除非你本机装了 Docker 却想强制直跑，或反过来）
# TRAINING_EXECUTOR=auto
# TRAINING_EXECUTOR=process
# TRAINING_EXECUTOR=docker
