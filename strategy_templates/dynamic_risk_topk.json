  "name": "动态风控TOPK策略",
  "description": "动态股票池 TOPK + 快速崩盘过滤：均分 ≥ 0 全市场满仓，均分 < 0 沪深300五成仓；沪深300 近 10 日跌幅 ≤ -6% 或近 5 日 ≤ -4% 时次日降到三成仓，维持 3 个交易日。仓位每日检查，选股按 3 日低换手轮动。",
  "category": "advanced",
  "difficulty": "advanced",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票数量",
      "default": 50,
      "min": 5,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数量（0 = 不主动换仓）",
      "default": 10,
      "min": 0,
      "max": 200
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日），默认 3",
      "default": 3,
      "min": 1,
      "max": 60
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 3,
    "schedule_type": "interval",
    "trade_weekdays": [],
    "enabled_sessions": ["PM"],
    "sell_time": "14:30",
    "buy_time": "14:45",
    "sell_first": true,
    "order_type": "LIMIT",
    "max_price_deviation": 0.02,
    "max_orders_per_cycle": 20
  },
  "live_config_tips": [
    "仓位规则：均分 ≥ 0 满仓；< 0 五成仓；指数急跌时三成仓。",
    "崩盘过滤：沪深300 10 日跌幅 ≤ -6% 或 5 日 ≤ -4%，维持 3 个交易日。",
    "仓位每日检查，选股按 rebalance_days 轮动。"
