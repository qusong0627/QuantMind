{
  "id": "as38_drawdown_throttle",
  "name": "A股回撤阶梯降仓",
  "description": "自定义类：按沪深 300 距 250 日高点的回撤分四档降仓，回撤越深仓位越低。",
  "category": "risk_control",
  "difficulty": "advanced",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 40,
      "min": 5,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数",
      "default": 10,
      "min": 0,
      "max": 200
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 5,
      "min": 1,
      "max": 60
    },
    {
      "name": "dd_lookback",
      "description": "回撤参考窗口（交易日）",
      "default": 250,
      "min": 20,
      "max": 500
    },
    {
      "name": "dd_l1",
      "description": "回撤档位 1（0.05=5%）",
      "default": 0.05,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "dd_l2",
      "description": "回撤档位 2",
      "default": 0.1,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "dd_l3",
      "description": "回撤档位 3",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "pos_l1",
      "description": "档位 1 对应仓位",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "pos_l2",
      "description": "档位 2 对应仓位",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "pos_l3",
      "description": "档位 3 对应仓位",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "pos_l4",
      "description": "档位 4 对应仓位",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "f_total_mv_min",
      "description": "总市值下限（元）",
      "default": 3000000000.0,
      "min": 0
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 5,
    "schedule_type": "interval",
    "trade_weekdays": [],
    "enabled_sessions": [
      "PM"
    ],
    "sell_time": "14:30",
    "buy_time": "14:45",
    "sell_first": true,
    "order_type": "LIMIT",
    "max_price_deviation": 0.02,
    "max_orders_per_cycle": 20
  },
  "live_config_tips": [
    "回撤档位基于指数而非组合自身，避免组合回撤后才被动降仓。",
    "最深档位 40% 仓位是「保命线」，可按风险偏好上调。"
  ],
  "markets": [
    "a_share"
  ],
  "dir": "A股策略/08_风险控制与仓位"
}
