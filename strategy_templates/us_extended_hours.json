{
  "id": "us_extended_hours",
  "name": "美股盘后延长时段",
  "description": "标准 Top 30 选股，但调仓落在**盘后延长时段**（16:00–20:00 美东）。",
  "category": "advanced",
  "difficulty": "advanced",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 30,
      "min": 5,
      "max": 100
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数",
      "default": 6,
      "min": 0,
      "max": 100
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
