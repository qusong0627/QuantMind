{
  "id": "as01_core_multifactor",
  "name": "A股宽基多因子核心",
  "description": "以模型信号为核心，叠加市值、流动性、估值三层硬过滤的宽基组合；周频调仓，是全部 A 股策略的对照基准。",
  "category": "basic",
  "difficulty": "beginner",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 50,
      "min": 5,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数",
      "default": 10,
      "min": 0,
      "max": 200
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 3,
      "min": 1,
      "max": 60
    },
    {
      "name": "f_total_mv_min",
      "description": "总市值下限（元）",
      "default": 3000000000.0,
      "min": 0
    },
    {
      "name": "f_amount_ma_5_min",
      "description": "5 日均成交额下限（万元）",
      "default": 5000,
      "min": 0
    },
    {
      "name": "f_pe_ttm_min",
      "description": "PE(TTM) 下限（剔除亏损）",
      "default": 0.0,
      "min": -50,
      "max": 300
    },
    {
      "name": "f_pe_ttm_max",
      "description": "PE(TTM) 上限",
      "default": 80,
      "min": 0,
      "max": 300
    },
    {
      "name": "f_pb_max",
      "description": "PB 上限",
      "default": 10.0,
      "min": 0.1,
      "max": 30
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 3,
    "schedule_type": "interval",
    "trade_weekdays": [],
    "enabled_sessions": [
      "PM"
    ],
    "sell_time": "14:30",
    "buy_time": "14:45",
    "sell_first": true,
    "order_type": "LIMIT",
    "max_price_deviation": 0.02,
    "max_orders_per_cycle": 20
  },
  "live_config_tips": [
    "宽基核心建议配合中长期模型信号；市值下限 30 亿可剔除大部分壳资源股。",
    "PE 下限 0 用于剔除亏损股，PE 缺失的标的也会被过滤。"
  ],
  "markets": [
    "a_share"
  ],
  "dir": "A股策略/01_宽基多因子"
