{
  "id": "as44_panic_reversal",
  "name": "A股恐慌低吸",
  "description": "上一交易日跌幅 2%-9%、中期趋势仍向上（站上 20 日线）、RSI<55 的单日恐慌错杀。",
  "category": "advanced",
  "difficulty": "advanced",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 25,
      "min": 5,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数",
      "default": 12,
      "min": 0,
      "max": 200
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 3,
      "min": 1,
      "max": 60
    },
    {
      "name": "f_pct_change_min",
      "description": "上一交易日涨跌幅下限（%）",
      "default": -9.0,
      "min": -30,
      "max": 30
    },
    {
      "name": "f_pct_change_max",
      "description": "上一交易日涨跌幅上限（%）",
      "default": -2.0,
      "min": -30,
      "max": 30
    },
    {
      "name": "f_ma_gap_20_min",
      "description": "相对 20 日均线偏离下限（%）",
      "default": 0.0,
      "min": -50,
      "max": 50
    },
    {
      "name": "f_rsi_14_max",
      "description": "RSI(14) 上限",
      "default": 55,
      "min": 0,
      "max": 100
    },
    {
      "name": "f_amount_ma_5_min",
      "description": "5 日均成交额下限（万元）",
      "default": 10000,
      "min": 0
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
