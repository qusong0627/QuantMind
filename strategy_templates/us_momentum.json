{
  "id": "us_momentum",
  "name": "美股动量先锋",
  "description": "模型分叠加 20 日动量（权重 30%）的顺势配置，吃趋势主升段。",
  "category": "advanced",
  "difficulty": "intermediate",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 30,
      "min": 5,
      "max": 100
    },
    {
      "name": "momentum_period",
      "description": "动量回看天数",
      "default": 20,
      "min": 5,
      "max": 60
    },
    {
      "name": "momentum_weight",
      "description": "动量因子权重",
      "default": 0.3,
      "min": 0.0,
      "max": 0.6
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 3,
      "min": 1,
      "max": 60
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.04,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 3,
    "enabled_sessions": [
      "AM"
    ],
    "sell_time": "15:50",
    "buy_time": "15:58",
    "sell_first": true
  },
  "live_config_tips": [
    "美股动量在风格切换期回撤放大，建议结合大盘状态过滤。",
    "时间均为美东钟点（平台自动换算）。"
  ],
  "markets": [
    "us_stock"
  ]
}
