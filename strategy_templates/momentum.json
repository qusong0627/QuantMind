{
  "id": "momentum",
  "name": "趋势动量策略 (Momentum)",
  "description": "基于\"强者恒强\"逻辑，自动筛选过去一段时间涨幅最高且波动稳健的行业或个股。",
  "category": "basic",
  "difficulty": "beginner",
  "params": [
    {
      "name": "topk",
      "description": "选股数量",
      "default": 30,
      "min": 5,
      "max": 100
    },
    {
      "name": "n_drop",
      "description": "每期替换数量",
      "default": 6,
      "min": 1,
      "max": 50
    },
    {
      "name": "momentum_period",
      "description": "动量回看周期 (天)",
      "default": 20,
      "min": 5,
      "max": 60
    },
    {
      "name": "momentum_weight",
      "description": "动量因子强度 (0~1，越大越依赖动量)",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 3
  },
  "live_config_tips": [
    "趋势策略换手偏高：请关注成本占比；趋势反转期建议结合大盘状态过滤。"
  ],
  "dir": "通用策略",
  "markets": []
}
