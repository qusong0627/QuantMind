  "live_defaults": {
    "rebalance_days": 5,
    "schedule_type": "interval",
    "trade_weekdays": [],
    "enabled_sessions": [
      "PM"
    ],
    "sell_time": "14:30",
    "buy_time": "14:45",
    "sell_first": true,
    "order_type": "LIMIT",
    "max_price_deviation": 0.02,
    "max_orders_per_cycle": 20
  },
  "live_config_tips": [
    "大盘状态判定需要开启动态仓位，否则只生效行业上限与个股过滤。",
    "波动率上限用百分数口径（4% 日波动），不是 0.04。"
  ],
  "markets": [
    "a_share"
  ],
  "dir": "A股策略/08_风险控制与仓位"
