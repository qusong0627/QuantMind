{
  "id": "us_weighted_core",
  "name": "美股加权核心",
  "description": "按分数加权建仓 Top 25、单票上限 8%，兼顾集中与分散。",
  "category": "basic",
  "difficulty": "intermediate",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 25,
      "min": 5,
      "max": 100
    },
    {
      "name": "min_score",
      "description": "最低入选分数",
      "default": 0.0
    },
    {
      "name": "max_weight",
      "description": "单票权重上限",
      "default": 0.08,
      "min": 0.01,
      "max": 0.2
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 5,
      "min": 1,
      "max": 60
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.08
  },
  "live_defaults": {
    "rebalance_days": 5,
    "enabled_sessions": [
      "AM"
    ],
    "sell_time": "15:50",
    "buy_time": "15:58",
    "sell_first": true
  },
  "live_config_tips": [
    "加权组合注意头部集中：单票上限 8% 已控风险。",
    "时间均为美东钟点（平台自动换算）。"
  ],
  "markets": [
    "us_stock"
  ]
}
