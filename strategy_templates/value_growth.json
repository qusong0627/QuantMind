{
  "id": "value_growth",
  "name": "价值成长策略",
  "description": "基于模型信号选股，并以 features_daily 的市值、PE/PB/PS 与 TTM 营收、净利润筛选价值与经营质量兼具的标的。",
  "category": "basic",
  "difficulty": "intermediate",
  "params": [
    {
      "name": "topk",
      "description": "目标持仓股票数",
      "default": 30,
      "min": 10,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每次调仓最大替换数",
      "default": 5,
      "min": 1,
      "max": 50
    },
    {
      "name": "f_pe_ttm_max",
      "description": "PE（TTM）上限",
      "default": 25,
      "min": 1,
      "max": 100
    },
    {
      "name": "f_pb_max",
      "description": "PB 上限",
      "default": 3.5,
      "min": 0.1,
      "max": 20
    },
    {
      "name": "f_ps_ttm_max",
      "description": "PS（TTM）上限",
      "default": 6,
      "min": 0.1,
      "max": 50
    },
    {
      "name": "f_total_mv_min",
      "description": "总市值下限（元）",
      "default": 1000000000,
      "min": 0
    },
    {
      "name": "f_total_mv_max",
      "description": "总市值上限（元）",
      "default": 50000000000,
      "min": 0
    },
    {
      "name": "f_float_mv_min",
      "description": "流通市值下限（元）",
      "default": 500000000,
      "min": 0
    },
    {
      "name": "f_net_profit_ttm_min",
      "description": "TTM 净利润下限（元）",
      "default": 50000000,
      "min": 0,
      "max": 100000000000
    },
    {
      "name": "f_revenue_ttm_min",
      "description": "TTM 营收下限（元）",
      "default": 500000000,
      "min": 0,
      "max": 1000000000000
    }
  ],
  "execution_defaults": {
    "max_buy_drop": -0.03,
    "stop_loss": -0.1
  },
  "live_defaults": {
    "rebalance_days": 5
  },
  "live_config_tips": [
    "筛选字段来自 features_daily；PE 为负或缺失的标的不会进入候选池。",
    "TTM 营收和净利润是经营质量门槛，不等同于同比增长率。"
  ],
  "dir": "通用策略",
  "markets": [
    "a_share"
  ]
}
