  "category": "basic",
  "difficulty": "beginner",
  "params": [
    {
      "name": "topk",
      "description": "持仓股票总数",
      "default": 30,
      "min": 5,
      "max": 200
    },
    {
      "name": "n_drop",
      "description": "每期最大替换数",
      "default": 5,
      "min": 0,
      "max": 200
    },
    {
      "name": "rebalance_days",
      "description": "调仓周期（交易日）",
      "default": 20,
      "min": 1,
      "max": 60
    },
    {
      "name": "f_dividend_rate_min",
      "description": "股息率下限（小数，0.02=2%）",
      "default": 0.03,
      "min": 0.0,
      "max": 0.2
    },
    {
      "name": "f_pe_ttm_max",
      "description": "PE(TTM) 上限",
      "default": 20,
      "min": 0,
      "max": 300
    },
    {
      "name": "f_pb_max",
      "description": "PB 上限",
      "default": 2.5,
      "min": 0.1,
      "max": 30
    },
    {
      "name": "f_total_mv_min",
      "description": "总市值下限（元）",
      "default": 10000000000.0,
      "min": 0
    },
    {
      "name": "f_amount_ma_5_min",
      "description": "5 日均成交额下限（万元）",
      "default": 5000,
      "min": 0
    }
