# QuantMind 前端生产构建环境
# 可从 .env.template 复制并按需修改
#
# 【默认：同域部署（推荐 Web）】
# 不设置 VITE_API_BASE_URL，前端走相对路径。
# API 请求通过 vite proxy（dev 模式）或 nginx 转发到后端。
# WebSocket 使用浏览器当前域名自动拼接。
#
# 【Electron 桌面端（exe）】
# 前端代码内置兜底：未配置任何服务器地址时，自动使用
# http://127.0.0.1:8000（对应本地 Docker 的 api 网关），
# 并在启动时对持久化地址做 /health 校验，失效自动清除缓存回退。
# 如需远程服务器，在登录页「服务器配置」中填写 IP 即可。
#
# 【本地开发直连方案】
# VITE_SERVICE_HOST=127.0.0.1
# VITE_HTTP_PROTOCOL=http
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_WS_BASE_URL=ws://127.0.0.1:8003/api/v1/ws/market
#
# 【远程 HTTPS 直连方案】
# VITE_SERVICE_HOST=YOUR_SERVER_HOST
# VITE_HTTP_PROTOCOL=https
# VITE_API_BASE_URL=https://YOUR_SERVER_HOST
# VITE_WS_BASE_URL=wss://YOUR_SERVER_HOST/ws/api/v1/ws/market

# 生产环境屏蔽区块链（CRYPTO）市场：false 关闭
VITE_ENABLE_CRYPTO=false

# 生产环境屏蔽实盘交易（券商通道 / QMT 真单镜像 / 实盘模式切换）：false 关闭
# 与后端 ENABLE_REAL_TRADING 是同一件事的两端，恢复实盘需两端同时置 true
VITE_ENABLE_REAL_TRADING=false
