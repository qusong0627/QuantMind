# QuantMind OSS Edition 环境变量配置模板
# 复制此文件为 .env 并修改相应配置：
#   cp .env.example .env

# ============================================
# 基础配置
# ============================================
APP_EDITION=oss
APP_ENV=production
TZ=Asia/Shanghai

# ============================================
# 安全配置（生产环境必须修改！）
# ============================================
# 建议使用: openssl rand -hex 32
# **留空 = 启动时自动生成强随机并写入 config/runtime.env**，此后固定不变
# （不会每次重启轮换）。留空是**安全**选择：代码把一切公开字面量
# （CHANGE_ME_* / dev-secret-key / changeme-*）视为「未配置」并拒绝服务。
# ⚠️ 这里曾经印着一个真实字面量（曾被当作有效值用于签用户 JWT）——不要照抄任何
#    示例值填进来，那等于把签名密钥公开。
SECRET_KEY=
JWT_SECRET_KEY=

# RD-Agent 内部调用密钥（可选），语义同上：留空 = 启动时自动生成并落盘 runtime.env。
INTERNAL_CALL_SECRET=

# 对外 API（/api/ext/v1）的签名密钥。外部系统/智能体用访问凭据换会话令牌时用。
# **留空 = 对外 API 整体不可用**（握手返回 503），这是有意的：不回落到任何默认值。
# 生成：openssl rand -hex 32
EXTERNAL_API_SECRET=

# ============================================
# 端口绑定
# ============================================
# 8000 是唯一对外入口（局域网客户端、AutoDL 训练节点回调都依赖它）。
# 8001-8003 默认只绑回环——绑全网卡等于绕过网关上的鉴权/限流/审计
# （C1 事故里被利用过的形状）。确有需要时在 .env 里覆盖，别改 compose 默认值。
QM_API_BIND=0.0.0.0
QM_ENGINE_BIND=127.0.0.1
QM_TRADE_BIND=127.0.0.1
QM_STREAM_BIND=127.0.0.1

# ============================================
# 数据库配置
# ============================================
DB_HOST=db
DB_PORT=5432
DB_NAME=quantmind
DB_USER=quantmind
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# 远程数据源（用于从官方数据库拉取增量数据）
# 留空则只使用本地数据
SOURCE_DATABASE_URL=

# /api/v1/public/sync/feature-snapshots 的上游库地址（含 152 维特征快照）。
# **留空 = 该端点返回 500**（不回落到任何硬编码地址）。该端点已要求登录，
# 匿名一律 401。凭据请走环境变量/runtime.env，不要写进源码——曾经硬编码过，
# 那枚口令必须视为已泄露并在服务端轮换。
QM_PUBLIC_SYNC_REMOTE_DB_URL=

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 实时行情 Redis（模拟盘成交只接受此源的新鲜行情）
REMOTE_QUOTE_REDIS_HOST=redis
REMOTE_QUOTE_REDIS_PORT=6379
REMOTE_QUOTE_REDIS_PASSWORD=
REMOTE_QUOTE_REDIS_DB=3
SIM_REDIS_QUOTE_MAX_AGE_SEC=300
SIM_LIQUIDITY_WINDOW_SEC=60
SIMULATION_MAX_PARTICIPATION_RATE=0.10
SIM_LIQUIDITY_UNVERIFIED_MAX_NOTIONAL=100000

# ============================================
# 存储配置
# ============================================
STORAGE_MODE=local
STORAGE_ROOT=/data

# ============================================
# 融资融券股票池路径（容器内路径）
# ============================================
MARGIN_STOCK_POOL_PATH=/data/融资融券.json

# ============================================
# 服务端口
# ============================================
API_PORT=8000
ENGINE_PORT=8001
TRADE_PORT=8002
STREAM_PORT=8003
WEB_PORT=3080

# ============================================
# Worker 配置
# ============================================
API_WORKERS=1
ENGINE_WORKERS=1
TRADE_WORKERS=1
STREAM_WORKERS=1

# ============================================
# 服务间通信 URL（OSS 单镜像模式使用 localhost）
# ============================================
TRADE_SERVICE_URL=http://127.0.0.1:8002
ENGINE_SERVICE_URL=http://127.0.0.1:8001
AI_IDE_SERVICE_URL=http://127.0.0.1:8001
STREAM_SERVICE_URL=http://127.0.0.1:8003
MARKET_DATA_SERVICE_URL=http://127.0.0.1:8003
STRATEGY_SERVICE_URL=http://127.0.0.1:8001
PORTFOLIO_SERVICE_URL=http://127.0.0.1:8002
USER_SERVICE_URL=http://127.0.0.1:8002
REAL_TRADING_SERVICE_URL=http://127.0.0.1:8002

# ============================================
# 调试配置
# ============================================
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# 策略模板目录
# ============================================
STRATEGY_TEMPLATES_DIR=/app/strategy_templates

# ============================================
# 回测结果存储目录
# ============================================
QLIB_BACKTEST_RESULT_DIR=/data/backtest_results

# ============================================
# 模型训练配置（Docker 编排）
# ============================================
TRAINING_IMAGE=quantmind-oss:latest
TRAINING_DOCKER_NETWORK=quantmind_quantmind-net
HOST_PROJECT_PATH=.
QUANTMIND_API_BASE_URL=http://quantmind:8000

# ============================================
# AI 模型 API Key（必须配置！）
# ============================================
# AI LLM API Key（可选，仅影响 AI 策略/因子挖掘/投研功能）
# 不配置时平台核心功能（数据/回测/训练/选股）仍可用，AI 功能会提示需配置 Key
# ============================================

# 方案 1: Qwen / DashScope API Key（用于 AI 策略功能）
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 方案 2: Qwen API Key（同上，别名）
QWEN_API_KEY=

# 方案 3: DeepSeek API Key（可选）
# 获取地址: https://platform.deepseek.com/
# 说明：模型/地址/密钥以「个人中心 → AI 服务配置」为准，此处 env 仅作无用户配置时兜底。
AI_IDE_LLM_API_KEY=
AI_IDE_LLM_BASE_URL=

# minibt 策略运行时(executor 检测到 `import minibt` 自动切换;先构建: bash docker/build_minibt_runner.sh)
AI_IDE_MINIBT_RUNNER_IMAGE=quantmind-minibt-runner:latest
AI_IDE_DOCKER_TIMEOUT=180

# ============================================
# 量化因子 AI Key（可选）
# ============================================
# 用于因子演化、智能策略生成等功能（以用户「AI 服务配置」为准，env 兜底）
# DeepSeek: OpenAI 兼容 https://api.deepseek.com / Anthropic 兼容 https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# ============================================
# QuantBot / dsh (DeepSeek Harness) 配置【默认后端】
# ============================================
# dsh 容器（quantmind-dsh）随全栈默认启动，控制台 http://<宿主>:8088（与旧 qwenpaw 同端口）。
# 模型走 DeepSeek 官方通道，复用上方 DEEPSEEK_API_KEY（⚠️ 不要为 dsh 设 DEEPSEEK_BASE_URL）。
# 浏览器访问 QuantBot 用的主机白名单：逗号/空格分隔的 host[:port]（不写端口默认 :DSH_PORT）。
# dsh 的 trusted-host 围栏与鉴权 cookie 都按 host:port 精确匹配 → 填实际访问地址
# （局域网 IP / 域名 / localhost）；留空时仅本机 localhost 直连可用。
DSH_TRUSTED_HOSTS=
# 宿主端口与绑定：默认与旧 qwenpaw 相同（0.0.0.0:8088）。⚠️ 前端 iframe 硬编码 8088，勿改端口。
DSH_BIND=0.0.0.0
DSH_PORT=8088
# agent 权限模式：danger-full-access 与旧 qwenpaw（无限制 shell + docker.sock）对等；
# 收紧可改 workspace-write（越界写操作需在 UI 逐次批准，会拦部分技能的 /data 写入）
DSH_PERMISSION_MODE=danger-full-access

# ============================================
# [legacy] QuantBot / QwenPaw 配置（回滚备份，默认不启动）
# 回滚：docker compose stop dsh && docker compose --profile legacy up -d qwenpaw
# ============================================
# QwenPaw 服务地址（Docker 网络内通过容器名访问）
QWENPAW_BASE_URL=http://qwenpaw:8088
COPAW_BASE_URL=http://qwenpaw:8088
QWENPAW_SHARED_FILES_DIR=/qwenpaw-shared
# QwenPaw 宿主机端口与绑定地址（默认 0.0.0.0 开放外部直连；QuantBot 页面由
# 浏览器/Electron 直连 <宿主>:8088。qwenpaw 为免登录模式，建议用云安全组/
# 防火墙限制来源 IP；确需仅本机访问则设为 127.0.0.1）
QWENPAW_PORT=8088
QWENPAW_BIND=0.0.0.0

# QwenPaw 认证信息（可选，如果 QwenPaw 启用了认证）
QWENPAW_AUTH_USERNAME=
QWENPAW_AUTH_PASSWORD=

# ============================================
# 市值单位配置
# ============================================
# 数据库存储单位为元，1亿=100,000,000
AI_STRATEGY_TOTAL_MV_PER_YI=100000000.0

# ============================================
# AutoDL 远程 GPU 训练（可选，留空则仅本地 CPU 训练）
# ============================================
# 推荐：AutoDL 官方 Python 实例用 exec_mode=native_python（无嵌套 Docker）。
# 节点写在 config/training_nodes.yaml（gitignore），脚本见 deploy/autodl/。
# 完整步骤：docs/部署指南.md 第十一节。
#
# 协调机公网 IP，供 AutoDL 训练结束回调 API（必填才能远程完成注册）
TRAINING_MASTER_HOST=
# 远端原生 Python（native_python 模式）
TRAINING_AUTODL_PYTHON=/root/miniconda3/bin/python
TRAINING_AUTODL_EXEC_MODE=native_python
TRAINING_AUTODL_QUANTDB_DIR=/root/autodl-fs/quantdb
#
# 【推荐】多节点配置在 config/training_nodes.yaml 声明（可配置多台，
#   后台「训练服务 → AutoDL 节点」可实时查看每台 CPU/GPU/内存/训练进度）。
#
# 以下单节点环境变量为向后兼容（YAML 未配置时使用）：
TRAINING_AUTODL_HOST=
TRAINING_AUTODL_SSH_PORT=22
TRAINING_AUTODL_USER=root
# SSH 认证：私钥路径或密码二选一
TRAINING_AUTODL_SSH_KEY=
TRAINING_AUTODL_SSH_PASSWORD=
# 远端工作目录（特征快照/配置/训练产物落盘处）
TRAINING_AUTODL_WORK_DIR=/workspace
# 远端训练镜像（需先在 AutoDL 节点构建并部署）
TRAINING_AUTODL_DOCKER_IMAGE=quantmind-train:latest
TRAINING_AUTODL_NODE_NAME=AutoDL GPU
# 远端容器挂载 GPU 数量（all=全部；节点需装 nvidia-container-toolkit）
TRAINING_AUTODL_GPUS=all

# ============================================
# 通达信 (TDX) 实盘交易桥配置
# ============================================
# 启用实盘交易 (false=仅模拟盘, true=REAL/SHADOW 订单走通达信)
#
# ⚠️ 开源版默认 false，**界面与接口都会一并关闭**（后端本开关 + 前端 VITE_ENABLE_REAL_TRADING
#    两个都打开才会显示实盘 UI，任一为 false 都不显示/都 403）。
# 启用前请确认你已履行程序化交易报告义务（向券商申报交易软件名称/版本号/开发者；
# 若触及高频阈值还须额外报告）。详见 DISCLAIMER.md。本工具不代为报告。
ENABLE_REAL_TRADING=false
# 实盘 broker 类型 (tdx | bridge | redis | qmt)
REAL_BROKER_TYPE=tdx
# 通达信交易桥地址 (Windows 侧 bridge-windows HTTP 服务)
TDX_BRIDGE_URL=http://192.168.31.39:8550
# 通达信交易桥鉴权 token (与 Windows 侧 BRIDGE_AUTH_TOKEN 一致)
TDX_BRIDGE_TOKEN=
# 通达信资金账号 (留空则用默认账号 account_id=0)
TDX_ACCOUNT=
# 账号类型: stock | credit | future | option
TDX_ACCOUNT_TYPE=stock

# --- 风控里的下单频率上限与法定高频阈值的关系 ---------------------------------
# 下单频率上限**不在这里配**，走 Redis `qm:risk:config` 的 l3.order_frequency.max_per_minute
# （页面「风控」页可改），默认 60 笔/分钟（=1 笔/秒）。
# 程序化交易的高频交易认定线是**每秒 300 笔**申报+撤单（=每分钟 18000 笔）或**单日 20000 笔**。
# 把 max_per_minute 调到 ≥18000 时后端会打 WARNING 提醒（只提醒、不拦单），因为撞线不违法，
# 但会被认定为高频交易并须额外报告系统服务器所在地/测试报告/故障应急方案。详见 DISCLAIMER.md。

# ============================================
# 大 QMT 执行端（big-convert RPC）+ 模拟盘真单镜像
# ============================================
# 执行端开关（页面「券商实盘接入 → 大 QMT(执行端)」写入的配置优先于这里）
QMT_EXEC_ENABLED=false
QMT_EXEC_ACCOUNT_ID=
# STOCK=普通 | CREDIT=信用
QMT_EXEC_ACCOUNT_TYPE=STOCK
QMT_EXEC_STRATEGY_NAME=quantmind
QMT_EXEC_TIMEOUT=10
# QMT 那台 Windows 上的 RPC Redis（big-convert 服务端通道）
QMT_EXEC_REDIS_HOST=
QMT_EXEC_REDIS_PORT=6380
QMT_EXEC_REDIS_DB=0
QMT_EXEC_REDIS_PASSWORD=
# 账户快照新鲜度告警：交易时段内超过阈值未成功落库 → 站内通知（冷却期内只报一次）
QMT_SYNC_STALE_ALERT_SECONDS=300
QMT_SYNC_STALE_ALERT_COOLDOWN_SECONDS=3600

# 模拟盘 → 真单镜像（默认关；开启后仅白名单策略会下单，并受下列限额约束）
SIMULATION_MIRROR_TO_REAL=false
MIRROR_MAX_ORDER_VALUE=10000
MIRROR_MAX_DAILY_VALUE=50000
MIRROR_MAX_DAILY_SYMBOLS=5
MIRROR_MAX_DAILY_ORDERS=20
MIRROR_MAX_SLIPPAGE_PCT=0.02
MIRROR_MAX_CONSECUTIVE_REJECTS=3
MIRROR_QUEUE_OUTSIDE_HOURS=true

# 远端行情 Redis（模拟撮合 L0 快照取价 / 实盘预检直连，两处共用同一配置源）
# 留空/不设置 = 使用官方公共免费行情服（默认值见 backend/shared/remote_quote_config.py）
# 私有部署建议显式配置；REMOTE_QUOTE_DISABLED=true 可整体关闭（撮合走本地日线兜底）
REMOTE_QUOTE_REDIS_HOST=
REMOTE_QUOTE_REDIS_PORT=
REMOTE_QUOTE_REDIS_PASSWORD=
REMOTE_QUOTE_REDIS_DB=
REMOTE_QUOTE_DISABLED=
